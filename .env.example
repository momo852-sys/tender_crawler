# Avoid putting SQLite DB files in cloud-sync folders. Use PostgreSQL in production.
DATABASE_URL=sqlite:///C:/tender_agent_data/tenders.db
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=1.5
USER_AGENT=TenderCrawlerAgent/0.1 (+contact@example.com)
API_TOKEN=change-me
DIFY_BASE_URL=http://127.0.0.1
DIFY_API_KEY=
DIFY_DATASET_ID=
DIFY_APP_API_KEY=
DIFY_APP_ENDPOINT=/v1/chat-messages
